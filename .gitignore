# Secrets: never commit
.env
.env.*
!.env.example
kaggle.json

# Python
__pycache__/
*.py[cod]
.venv/

# Pipeline scratch (outputs/ itself is committed so runs can be inspected)
.cache/
outputs/**/tmp/
outputs/**/*.part

# Notebooks / editors / OS
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store

# Rebuilt by `make film` with FFmpeg only (no model calls), so not committed:
outputs/shots/*.mp4
outputs/music/score.wav
outputs/edit/*.wav
outputs/edit/radio_cut.*
outputs/final/*.mp4
